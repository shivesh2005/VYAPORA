# ==============================================================================
# EJAN SEVA / VYAPORA — Global Environment Template (.env.example)
# SAFE FOR VERSION CONTROL — ONLY PLACEHOLDER VALUES INCLUDED
# ==============================================================================

# Node / Runtime Configuration
NODE_ENV=production
PORT=5000

# Frontend URL (Used for CORS and Cookie Origins)
# For local dev: http://localhost:3000
# For production: https://your-production-domain.vercel.app
CLIENT_URL=http://localhost:3000

# Database Configuration (MongoDB Atlas or Local MongoDB)
# For production: mongodb+srv://<db_user>:<db_password>@cluster0.xxxxx.mongodb.net/ejan_seva?retryWrites=true&w=majority
# For local demo: mongodb://127.0.0.1:27017/ejan_seva
# USE_IN_MEMORY_DB options: 'auto' (fallback on dev), 'false' (production requirement), 'true' (forced memory)
MONGODB_URI=mongodb+srv://your_db_user:your_db_password@cluster0.xxxxx.mongodb.net/ejan_seva?retryWrites=true&w=majority
USE_IN_MEMORY_DB=auto

# Security & Authentication (JWT & Cookies)
# Minimum 32-character random string for cryptographic security (e.g. openssl rand -base64 32)
JWT_SECRET=your_strong_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRES_IN=7d
COOKIE_NAME=ejan_token
ENCRYPTION_KEY=your_aes_256_gcm_encryption_key_for_ai_credentials_here

# Google Gemini AI Integration (Official SDK: @google/genai)
# Acquire an API key at https://aistudio.google.com/
# Leave blank to run in offline zero-friction catalog-grounded demo mode
AI_PROVIDER=gemini
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=20000

# Rate Limiting & DoS Protection
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Client-Side Configuration (Optional, for decoupled frontend hosting on Vercel)
# When frontend and backend are hosted on separate domains:
# VITE_API_URL=https://your-backend-api.onrender.com
