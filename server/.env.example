# ==============================================================================
# Backend Server Environment Template (server/.env.example)
# SAFE FOR VERSION CONTROL — ONLY PLACEHOLDER VALUES
# ==============================================================================

NODE_ENV=production
PORT=5000
CLIENT_URL=http://localhost:3000

# MongoDB Connection String (Atlas URI recommended for production)
MONGODB_URI=mongodb+srv://your_db_user:your_db_password@cluster0.xxxxx.mongodb.net/ejan_seva?retryWrites=true&w=majority
USE_IN_MEMORY_DB=auto

# Security & Secrets
JWT_SECRET=your_strong_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRES_IN=7d
COOKIE_NAME=ejan_token
ENCRYPTION_KEY=your_aes_256_gcm_encryption_key_for_ai_credentials_here

# AI Configuration (Official Google Gen AI SDK: @google/genai)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=20000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
