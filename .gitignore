# ==============================================================================
# EJAN SEVA / VYAPORA — Git Exclusion Configuration (.gitignore)
# ==============================================================================

# Dependencies
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Production Build Outputs
dist/
build/
out/
*/dist/
*/build/
client/dist/
server/dist/

# Local Secret-Bearing Environment Files (CRITICAL — NEVER COMMIT)
.env
.env.*
!.env.example
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
server/.env
server/.env.local
client/.env
client/.env.local

# Vercel Deployment Artifacts & Account Metadata
.vercel/

# Private Credentials & Service Account Files
*.pem
*.key
*.cert
*.pfx
*.p12
service-account*.json
credentials*.json

# Local Logs & Diagnostic Traces
logs/
*.log
*.log.*
server/logs/

# Local Database Dumps & Cache
*.dump
*.sql
*.sqlite
*.sqlite3
mongo-dump/
.mongodb/
.cache/

# Local Uploads & Static Media Caches
uploads/
server/uploads/
server/public/uploads/

# Testing Coverage & Reports
coverage/
.nyc_output/
.vitest/

# OS-Specific Files & Temporary Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.tmp
*.temp

# IDE & Editor Local Files
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.sublime-project
*.sublime-workspace
*.swp
*.swo
